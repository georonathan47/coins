  "version": "0.2.0",
  "configurations": [

    {
      "name": "Debug",
      "request": "launch",
      "type": "dart",
      "program": "lib/env/dev.dart",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file",
        "assets/configs/dev.env"
      ]
    },
    {
      "name": "Profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "args": [
        "--flavor",
        "dev",
        "--dart-define-from-file",
        "assets/configs/dev.env"
      ]
    },
    {
      "name": "Release",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}